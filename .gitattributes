# Normalize line endings: store everything as LF in the repository and let
# Git handle the working-tree conversion per platform. This is what stops the
# CRLF/LF churn that otherwise shows up as spurious whole-file diffs.
* text=auto eol=lf

# Scripts that must keep their platform-native endings
*.sh   text eol=lf
mvnw   text eol=lf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary assets — never touch these
*.jar  binary
*.war  binary
*.ear  binary
*.class binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary
