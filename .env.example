# Workflow-Embedded Micro-Hubs — Environment Variables
# Copy this file to .env and fill in real values before running docker compose up.

# ── JWT ──────────────────────────────────────────────────────
# Secret key for JWT token signing. Must be at least 32 characters.
JWT_SECRET=change-me-to-a-random-32-char-string

# ── LLM (Groq) ──────────────────────────────────────────────
# Your Groq API key (from https://console.groq.com)
# Used for AI knowledge extraction when capsules are resolved.
LLM_API_KEY=your_groq_api_key_here

# Groq API base URL (default works for most users)
LLM_BASE_URL=https://api.groq.com/openai/v1

# ── Database (optional — only needed if overriding defaults) ─
# The defaults in docker-compose.yml work out of the box.
# POSTGRES_DB=microhubs
# POSTGRES_USER=microhubs
# POSTGRES_PASSWORD=password
